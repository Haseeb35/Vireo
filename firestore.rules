rules_version = '2';

// Vireo security rules.
// Each signed-in user can read and write only their own document (users/{uid})
// and anything underneath it (profiles, My List, watch progress).
// Everything else is denied.
// ({document=**} matches zero or more path segments in rules v2, so this covers
// users/{uid} itself as well as every subcollection.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
