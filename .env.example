# ── Firebase ──────────────────────────────────────────────
# Firebase console → ⚙️ Settings → General → Your apps → Vireo Web → Config
# (These are safe to expose in the browser; Firebase security rules protect the data.)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── TMDB ──────────────────────────────────────────────────
# themoviedb.org → Settings → API → "API Read Access Token" (the long one starting with eyJ)
# Server-only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
TMDB_ACCESS_TOKEN=
